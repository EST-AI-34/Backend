DATABASE_URL=postgres://festival:festival@localhost:5432/festival
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
VISITOR_SESSION_HOURS=24
ENVIRONMENT=development

# myAlan(앨런) LLM 연동. false면 규칙 기반 문장만 사용한다.
# bearer가 운영 기본값이고, 개발용 POC에서만 implicit + ALLEN_CLIENT_ID를 쓴다.
# 두 모드는 서로 대체되지 않으며 ALLEN_API_KEY를 client id로 재사용하지 않는다.
ENABLE_EXTERNAL_AI=false
ALLEN_API_BASE_URL=https://api.myalan.ai/api/v1
ALLEN_AUTH_MODE=bearer
ALLEN_AUTH_BASE_URL=https://api.myalan.ai
ALLEN_API_KEY=
ALLEN_CLIENT_ID=
ALLEN_LLM_ENDPOINT=/channels
ALLEN_PERSONA_ID=69ce0aeab459faf50a427005
ALLEN_DEVICE_PLATFORM=web
ALLEN_DEVICE_VERSION=2.0.4
ALLEN_CONNECT_TIMEOUT_SECONDS=3
ALLEN_READ_TIMEOUT_SECONDS=30
ALLEN_MAX_RETRIES=2
ALLEN_MESSAGE_POLL_SECONDS=2
ALLEN_MESSAGE_POLL_ATTEMPTS=20
