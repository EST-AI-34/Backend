DATABASE_URL=postgres://festival:festival@localhost:5432/festival
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
VISITOR_SESSION_HOURS=24
ENVIRONMENT=development

# Alan 오픈 API. false면 외부 호출 없이 규칙 기반 문장만 사용한다.
# ALAN_CLIENT_ID는 발급받은 UUID이며 커밋하지 말고 배포 환경변수로만 주입한다.
ENABLE_EXTERNAL_AI=false
ALAN_QUESTION_URL=https://kdt-api-function.azurewebsites.net/api/v1/question
ALAN_CLIENT_ID=
ALAN_CONNECT_TIMEOUT_SECONDS=3
ALAN_READ_TIMEOUT_SECONDS=8
ALAN_MAX_RETRIES=1

# 추천 노출 이력 보존 기간. 편향 점검 조회 창(최대 90일)보다 짧게 두지 말 것.
RECOMMENDATION_EVENT_RETENTION_DAYS=90
