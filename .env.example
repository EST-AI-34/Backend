DATABASE_URL=postgres://festival:festival@localhost:5432/festival
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
VISITOR_SESSION_HOURS=24
ENVIRONMENT=development

# 프록시(Railway·Vercel) 뒤에서만 true. request.client.host가 프록시 IP라 레이트 리밋
# 버킷을 전 사용자가 공유하는 문제를 X-Forwarded-For로 푼다. 직결 배포에서 켜면
# 클라이언트가 헤더를 위조해 한도를 우회할 수 있다.
# 값을 지우면 PaaS 표식(RAILWAY_ENVIRONMENT/VERCEL)이 있을 때만 자동으로 켜진다.
TRUST_PROXY_HEADERS=false

# 로그인 실패 잠금. 계정당 실패가 한도를 넘으면 잠금 시간 동안 비밀번호를 받지 않는다.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=5

# Alan 오픈 API. false면 외부 호출 없이 규칙 기반 문장과 승인 콘텐츠 요약만 사용한다.
# ALAN_CLIENT_ID는 발급받은 UUID이며 커밋하지 말고 배포 환경변수로만 주입한다.
ENABLE_EXTERNAL_AI=false
ALAN_QUESTION_URL=https://kdt-api-function.azurewebsites.net/api/v1/question
ALAN_CLIENT_ID=
ALAN_CONNECT_TIMEOUT_SECONDS=3
ALAN_READ_TIMEOUT_SECONDS=8
ALAN_MAX_RETRIES=1

# 추천 노출 이력 보존 기간. 편향 점검 조회 창(최대 90일)보다 짧게 두지 말 것.
RECOMMENDATION_EVENT_RETENTION_DAYS=90

# 잡 워커가 주기적으로 지우는 만료 데이터의 보존 기간.
IDEMPOTENCY_RETENTION_DAYS=7
VISITOR_SESSION_RETENTION_DAYS=180
