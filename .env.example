PROJECT_NAME=FEST Backend
VERSION=1.0.0
DEBUG=true
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Allen / Alan / LLM integration.
# Fill these when an external AI provider is available.
ALLEN_API_BASE_URL=https://api.allen.ai
ALLEN_API_KEY=

# Kakao Map integration.
# This JavaScript key is consumed by the FEST-Client frontend.
# Do not commit a real key here.
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=your_kakao_javascript_key_here
